<header class="site-header">
  <a
    class="brand"
    href={import.meta.env.BASE_URL}
    aria-label="Stock Predictor home"
  >
    <svg width="29" height="29" viewBox="0 0 32 32" aria-hidden="true"
      ><path
        d="M5 5v22h23M9 20l6-6 5 3 8-10M23 7h5v5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
    <span>stock predictor<span class="brand-period">.</span></span>
  </a>
  <nav aria-label="Main">
    <a class="nav-active" href="#workspace" aria-current="page">Forecast</a><a
      href="#methodology">How it works</a>
  </nav>
  <div class="connection">
    <span class="status-dot" id="connection-dot"></span><span
      id="connection-label">Connecting</span>
  </div>
  <a
    class="source-link"
    href="https://github.com/shiyu-coder/Kronos"
    target="_blank"
    rel="noopener noreferrer"
    >Kronos on GitHub <svg
      width="14"
      height="14"
      viewBox="0 0 20 20"
      aria-hidden="true"
      ><path
        d="M5 15 15 5M5 5h10v10"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></path></svg
    ></a
  >
</header>
