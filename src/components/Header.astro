<header class="site-header">
  <div class="brand-lockup">
  <a class="brand" href={import.meta.env.BASE_URL} aria-label="Stock Predictor home"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 5v22h23M9 20l6-6 5 3 8-10M23 7h5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span>stock predictor<span class="brand-period">.</span></span></a>
  <h1 class="navbar-headline">Price &amp; volume forecasts powered by <a class="kronos-link" href="https://github.com/shiyu-coder/Kronos" target="_blank" rel="noopener noreferrer" aria-label="Kronos on GitHub (opens in a new tab)">Kronos</a></h1>
  </div>
  <nav class="header-actions" aria-label="App navigation">
    <button class="nav-action" type="button" popovertarget="help-menu" aria-label="Help" title="Help"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 2-2.5 2-2.5 4m0 3h.01"/></svg><span>Help</span></button>
    <button class="nav-action settings-trigger" type="button" popovertarget="settings-menu" aria-label="Settings" title="Settings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h8m4 0h4M4 17h3m4 0h9"/><circle cx="14" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg><span>Settings</span></button>
    <button class="nav-action appearance-trigger" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="sun-icon"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></g><path class="moon-icon" d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg></button>
    <a class="nav-action project-link" href="https://github.com/statickidz/stock-predictor" target="_blank" rel="noopener noreferrer" aria-label="Project on GitHub" title="Project on GitHub"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1-4-2-6-2m12 4v-3.5c0-1 .1-1.5-.5-2 3.3-.4 6.5-1.6 6.5-7A5.5 5.5 0 0 0 19.5 5c.2-1 .1-2-.5-3-2 0-3.5 1.5-3.5 1.5a13 13 0 0 0-7 0S7 2 5 2c-.6 1-.7 2-.5 3A5.5 5.5 0 0 0 3 8.5c0 5.4 3.2 6.6 6.5 7-.6.5-.5 1-.5 2V21"/></svg><span>GitHub</span></a>
  </nav>
  <div id="help-menu" class="nav-popover help-menu" popover="auto" aria-label="Help">
    <p class="popover-title">Stock Predictor</p>
    <button type="button" data-dialog="about-dialog">About this project <span aria-hidden="true">↗</span></button>
    <button type="button" data-dialog="how-dialog">How it works <span aria-hidden="true">↗</span></button>
    <button type="button" data-dialog="disclaimer-dialog">Disclaimer <span aria-hidden="true">↗</span></button>
  </div>
  <div id="settings-menu" class="nav-popover settings-menu" popover="auto" aria-labelledby="settings-title">
    <h2 id="settings-title" class="popover-title">Settings</h2>
    <h3>Model storage</h3>
    <p>Remove downloaded model files to free browser storage. Models download again when needed. Your saved selections stay here.</p>
    <button id="clear-cache" class="secondary-button" type="button">Remove downloaded models</button>
    <p id="storage-status" role="status" aria-live="polite"></p>
  </div>
</header>
