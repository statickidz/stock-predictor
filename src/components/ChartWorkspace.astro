<section class="chart-panel" aria-labelledby="asset-name">
  <div class="asset-overview">
    <div class="asset-heading">
      <div class="asset-identity">
        <span class="asset-mark" id="asset-mark" aria-hidden="true">AAPL</span>
        <div>
          <h2 id="asset-name">Apple <span id="asset-symbol">AAPL</span></h2>
          <p id="asset-exchange">NASDAQ · USD</p>
        </div>
      </div>
    </div>
    <div class="quote-row">
      <span class="quote" id="last-price">—</span>
      <span class="daily-change" id="daily-change"></span>
      <p id="price-caption">Loading completed daily candles…</p>
    </div>
  </div>
  <div class="chart-toolbar">
    <div class="chart-ranges" role="group" aria-label="Chart history range">
      <button type="button" data-range="1" aria-pressed="false">1M</button>
      <button type="button" data-range="3" aria-pressed="true">3M</button>
      <button type="button" data-range="6" aria-pressed="false">6M</button>
      <button type="button" data-range="12" aria-pressed="false">1Y</button>
    </div>
    <div class="chart-legend">
      <span><i class="legend-observed"></i>Historical close</span>
      <span><i class="legend-forecast"></i>Kronos forecast</span>
    </div>
  </div>
  <div class="chart-wrap" id="chart-wrap" tabindex="0" aria-label="Closing price and volume chart. Tap or drag horizontally to inspect. Use left and right arrow keys, Home or End to explore prices and volume.">
    <svg id="price-chart" role="img" aria-label="Loading price chart"></svg>
    <div id="chart-message" class="chart-message">
      <div class="loading-rule"></div>
      <strong>Loading daily price history</strong>
      <span>Finding the latest published market snapshot.</span>
    </div>
    <div id="chart-tooltip" class="chart-tooltip" hidden></div>
    <span class="sr-only" role="status" aria-live="polite" data-chart-announcement></span>
  </div>
  <div class="chart-foot">
    <p class="chart-interaction-hint"><span class="pointer-hint">Hover to inspect · arrow keys to move</span><span class="touch-hint">Tap or drag to inspect · swipe vertically to scroll</span></p>
    <span class="chart-note" id="chart-note">Completed candles only</span>
  </div>
  <div id="forecast-summary" class="forecast-summary" hidden>
    <div><span>Projected close</span><strong id="projected-price">—</strong></div>
    <div><span>Projected change</span><strong id="projected-change">—</strong></div>
    <div><span>Forecast through</span><strong id="projected-date">—</strong></div>
  </div>
  <div class="forecast-empty" id="forecast-empty">
    <span class="empty-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24"><path d="m3 17 5-5 4 3 8-10M15 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
    <div><strong>Explore the path ahead</strong><p>Choose a horizon and generate a forecast to add projected prices and daily results.</p></div>
  </div>
</section>
