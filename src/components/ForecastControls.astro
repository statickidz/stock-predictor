<aside class="forecast-panel" aria-labelledby="forecast-heading">
  <div class="sidebar-heading"><h2 id="forecast-heading">Build a forecast</h2>
  </div>
  <div class="sidebar-scroll">
  <div class="composer-grid">
  <div class="asset-picker">
  <div class="market-switch" role="group" aria-label="Asset market">
    <button id="filter-stock" type="button" aria-pressed="true"
      >Stocks &amp; ETFs <span id="stock-count">—</span></button
    ><button id="filter-crypto" type="button" aria-pressed="false"
      >Crypto <span id="crypto-count">—</span></button>
  </div>
  <label for="asset-search" class="field-label">Search assets</label><div
    class="search-field"
  >
    <svg width="17" height="17" viewBox="0 0 20 20" aria-hidden="true"
      ><circle
        cx="8.5"
        cy="8.5"
        r="5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></circle><path
        d="m13 13 4 4"
        stroke="currentColor"
        stroke-width="1.5"></path></svg
    ><input
      id="asset-search"
      type="search"
      placeholder="Search by symbol or name…"
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <div id="asset-list" class="asset-list" aria-label="Supported assets">
    <p class="muted">Loading assets…</p>
  </div>
  </div>
  <div class="forecast-settings">
  <div class="horizon-field" role="group" aria-labelledby="horizon-label" aria-describedby="horizon-help"><div class="horizon-row">
    <span class="field-label" id="horizon-label">Forecast horizon</span><div
      class="horizon-options"
    >
      <button type="button" data-horizon="5" aria-pressed="false">5 days</button
      ><button type="button" data-horizon="10" aria-pressed="true"
        >10 days</button
      ><button type="button" data-horizon="20" aria-pressed="false"
        >20 days</button>
    </div></div><p id="horizon-help">Trading days only; skips weekends and holidays.</p>
  </div>
  <div class="model-field">
    <label for="model-select" class="field-label">Forecast model</label><select
      id="model-select"
      aria-describedby="model-help"
      disabled><option>Loading models…</option></select
    ><p id="model-help">Select the Kronos model to generate prices and volume.</p>
  </div>
  </div>
  </div>
  <div class="compute-field">
    <label for="runtime-select" class="field-label">Run forecast on</label>
    <select id="runtime-select" aria-describedby="runtime-help"><option value="wasm">WebAssembly · CPU</option><option value="webgpu">WebGPU · GPU</option></select>
    <p id="runtime-help">WebAssembly runs on your CPU.</p>
  </div>
  <div id="error-panel" class="error-panel" role="alert" hidden>
    <strong id="error-title">Unable to load data</strong><p id="error-message">
    </p><button id="retry-button" class="text-button" type="button"
      >Try again <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M6 7a7 7 0 0 1 12-1l2 6M4 12l2 6a7 7 0 0 0 12-1" /></svg></button>
  </div>
  </div>
  <div class="forecast-run">
  <button
    id="generate-button"
    class="primary-button generate"
    type="button"
    disabled
    ><span id="generate-label">Generate forecast</span><svg
      width="18"
      height="18"
      viewBox="0 0 20 20"
      aria-hidden="true"
      ><path
        d="M3 10h13M11 5l5 5-5 5"
        stroke="currentColor"
        fill="none"
        stroke-width="1.5"></path></svg
    ></button
  >
  <button id="cancel-button" class="secondary-button" type="button" hidden
    >Cancel forecast</button
  >
  <div class="connection sidebar-connection"><span class="status-dot" id="connection-dot"></span><span id="connection-label">Loading forecast options…</span></div>
  <div id="job-status" class="job-status" role="status" aria-live="polite">
    Saved models are reused.
  </div>
  </div>
</aside>
