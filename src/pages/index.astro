---
import AppLayout from '../layouts/AppLayout.astro';
import Header from '../components/Header.astro';
import ChartWorkspace from '../components/ChartWorkspace.astro';
import ForecastControls from '../components/ForecastControls.astro';
import ForecastResults from '../components/ForecastResults.astro';
import Methodology from '../components/Methodology.astro';
---
<AppLayout>
  <a class="skip-link" href="#workspace">Skip to forecast</a>
  <Header />
  <main id="workspace">
    <div class="page-heading"><div><h1>Explore what’s next.</h1><p>A little more perspective on the markets. Powered by Kronos.</p></div><span class="workspace-label"><span class="tiny-line"></span> Daily price forecasts</span></div>
    <div class="workspace-grid">
      <ChartWorkspace />
      <ForecastControls />
    </div>
    <ForecastResults />
    <Methodology />
  </main>
</AppLayout>
<script>
  import '../lib/app.js';
</script>
