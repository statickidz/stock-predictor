---
import AppLayout from '../layouts/AppLayout.astro';
import Header from '../components/Header.astro';
import ChartWorkspace from '../components/ChartWorkspace.astro';
import ForecastControls from '../components/ForecastControls.astro';
import ForecastResults from '../components/ForecastResults.astro';
import Methodology from '../components/Methodology.astro';
---
<AppLayout>
  <a class="skip-link" href="#workspace">Skip to forecast</a>
  <Header />
  <main id="workspace">
    <div class="workspace-grid">
      <ForecastControls />
      <div class="analysis-workspace">
        <ChartWorkspace />
        <ForecastResults />
        <Methodology />
      </div>
    </div>
  </main>
  <footer class="workspace-footer">
    <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 17 5-5 4 3 8-10M15 5h5v5" /></svg>Runs on your device · Daily snapshots</span>
    <button type="button" data-dialog="disclaimer-dialog">For research only · Not financial advice</button>
  </footer>
</AppLayout>
<script>
  import '../lib/app.js';
</script>
