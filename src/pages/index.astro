---
import AppLayout from '../layouts/AppLayout.astro';
import Header from '../components/Header.astro';
import ChartWorkspace from '../components/ChartWorkspace.astro';
import ForecastControls from '../components/ForecastControls.astro';
import ForecastResults from '../components/ForecastResults.astro';
import Methodology from '../components/Methodology.astro';
---
<AppLayout>
  <a class="skip-link" href="#workspace">Skip to forecast</a>
  <Header />
  <main id="workspace">
    <div class="workspace-grid">
      <ForecastControls />
      <div class="analysis-workspace">
        <ChartWorkspace />
        <ForecastResults />
        <Methodology />
      </div>
    </div>
  </main>
</AppLayout>
<script>
  import '../lib/app.js';
</script>
