---
import globalStyles from '../styles/global.css?url';
import darkStyles from '../styles/dark.css?url';
import interFont from '../assets/InterVariable.woff2?url';
import {SEO, getSeoUrls} from '../lib/seo.js';

interface Props {
  title?: string;
  description?: string;
}

const {title = SEO.title, description = SEO.description} = Astro.props;
const urls = getSeoUrls(Astro.site, import.meta.env.BASE_URL);
const structuredData = urls.canonical ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${urls.canonical}#website`,
      name: SEO.name,
      url: urls.canonical,
      description,
      inLanguage: 'en',
    },
    {
      '@type': 'WebApplication',
      '@id': `${urls.canonical}#application`,
      name: SEO.name,
      url: urls.canonical,
      description,
      image: urls.image,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript and WebAssembly.',
      isAccessibleForFree: true,
      offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
      isPartOf: {'@id': `${urls.canonical}#website`},
    },
  ],
} : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#f6f8fa" data-theme="light" media="not all" />
    <meta name="theme-color" content="#0e161d" data-theme="dark" media="all" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {urls.canonical && <link rel="canonical" href={urls.canonical} />}
    {urls.sitemap && <link rel="sitemap" type="application/xml" href={urls.sitemap} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {urls.canonical && <meta property="og:url" content={urls.canonical} />}
    <meta property="og:image" content={urls.image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SEO.imageWidth)} />
    <meta property="og:image:height" content={String(SEO.imageHeight)} />
    <meta property="og:image:alt" content={SEO.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urls.image} />
    <meta name="twitter:image:alt" content={SEO.imageAlt} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <meta name="inference-worker" content="" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={globalStyles} />
    <link id="dark-styles" rel="stylesheet" href={darkStyles} media="all" />
    <script is:inline>
      let theme = 'dark';
      try {
        const saved = localStorage.getItem('stock-predictor.theme');
        if (['light', 'dark', 'system'].includes(saved)) theme = saved;
      } catch {}
      {
        document.getElementById('dark-styles').media = theme === 'dark' ? 'all' : theme === 'light' ? 'not all' : '(prefers-color-scheme: dark)';
        document.documentElement.dataset.appearance = theme;
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.media = theme === 'system' ? `(prefers-color-scheme: ${meta.dataset.theme})` : (theme === meta.dataset.theme ? 'all' : 'not all');
        }
      }
    </script>
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
  </head>
  <body><slot /></body>
</html>
