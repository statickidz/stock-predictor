* text=auto

*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary

# Keep checked-in upstream bytes intact and exclude them from language totals.
vendor/** -text !eol linguist-vendored=true
tools/model-export/vendor/** -text !eol linguist-vendored=true
