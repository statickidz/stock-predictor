{
  "name": "stock-predictor",
  "version": "0.2.0",
  "description": "Static stock, ETF and crypto forecasting with browser-executed Kronos models.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0" },
  "dependencies": { "onnxruntime-web": "1.24.2", "yahoo-finance2": "4.0.5" },
  "devDependencies": { "astro": "7.4.4", "playwright": "1.62.1" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs --offline-data && node scripts/astro.mjs build && node scripts/check-dist.mjs",
    "build:ui": "node scripts/astro.mjs build",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:offline": "node scripts/prepare-assets.mjs --offline-data",
    "models:check": "node scripts/check-models.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:design": "node tests/night-studio-browser.mjs"
  }
}
