# Copy this file to .env to override defaults. Do not commit .env.
KRONOS_HOST=127.0.0.1
KRONOS_PORT=8000
KRONOS_DEVICE=auto
KRONOS_CPU_THREADS=4
KRONOS_MODEL=NeoQuasar/Kronos-small
# Matching tokenizer is selected automatically. Override only for custom models.
# KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
# Relative paths resolve from the project root when using the start scripts.
KRONOS_CACHE_DIR=.cache
# Optional locally; use a long random value when exposing the API on a server.
KRONOS_API_TOKEN=
